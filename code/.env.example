# Copy to code/.env and fill in your own values. Never commit .env.

# --- LLM ---
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=4
LLM_MAX_TOKENS=700

# --- Storage (absolute paths; keep large artifacts off the system disk) ---
DATA_DIR=/root/autodl-tmp/nlp/data
INDEX_DIR=/root/autodl-tmp/nlp/index
MODELS_DIR=/root/autodl-tmp/models
HF_HOME=/root/autodl-tmp/hf_cache
PREDICTION_PATH=/root/nlp/test_prediction.jsonl

# --- Hugging Face / mirrors ---
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
HF_HUB_ENABLE_HF_TRANSFER=0
HF_HUB_ETAG_TIMEOUT=60
HF_HUB_DOWNLOAD_TIMEOUT=600

# --- Retrieval / dense ---
EMBED_DEVICE=auto
RETRIEVAL_K=4
DENSE_DOC_WINDOWS=auto
DENSE_WINDOW_WORDS=700
DENSE_MAX_SEQ_LEN=1024
DENSE_BATCH_BGE=8
DENSE_BATCH_QWEN3=4
DENSE_NLIST=4096
DENSE_FLAT_THRESHOLD=30000

# --- Agent / context (assignment values) ---
MAX_ITERATIONS=10
MAX_TOOL_CALLS=8
CONTEXT_TOKEN_LIMIT=4000
DOC_READER_DEFAULT_CHARS=1000

# --- UI ---
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=0
